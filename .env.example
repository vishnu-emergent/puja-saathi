# ---------------------------------------------------------------- Sarvam AI
# dashboard.sarvam.ai → API keys
SARVAM_API_KEY=
# Optional overrides
# SARVAM_TTS_SPEAKER=kavya
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_CHAT_MODEL=sarvam-105b-conversations
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# ---------------------------------------------------------------- Flagsmith
# Environment → Settings → Keys
FLAGSMITH_ENVIRONMENT_KEY=
# Server-side key (ser.…) enables local evaluation — recommended
FLAGSMITH_SERVER_KEY=
# Organisation Settings → API Keys — lets the control room / setup script change flags
FLAGSMITH_ADMIN_API_KEY=

# ---------------------------------------------------------------- NudgeBee
# Workflow Builder → automation with a Webhook trigger → copy the generated URL
NUDGEBEE_WEBHOOK_URL=
# Optional: a second webhook-triggered automation that pre-scales on demand
NUDGEBEE_PRESCALE_WEBHOOK_URL=
# Protects POST /api/ops/events (NudgeBee reports progress there)
OPS_TOKEN=

# ---------------------------------------------------------------- tuning
PORT=8787
# RUSH_P95_THRESHOLD_MS=600
# SESSION_COST_ITERATIONS=160000
# In Kubernetes, point the rush at the Service so traffic spreads across pods:
# RUSH_TARGET_URL=http://puja-saathi.puja-saathi.svc.cluster.local
# DEMO_START=2026-11-08T17:30:00+05:30
