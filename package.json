{
  "name": "puja-saathi",
  "version": "1.0.0",
  "private": true,
  "description": "Your puja, guided in your mother tongue — at your city's muhurat. Built on Sarvam AI, Flagsmith and NudgeBee.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,magenta \"node --watch-path=server --env-file-if-exists=.env server/index.js\" \"vite\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "flagsmith:setup": "node --env-file-if-exists=.env scripts/flagsmith-setup.mjs",
    "panchang:cron": "node --env-file-if-exists=.env scripts/panchang-to-cron.mjs",
    "warm": "node --env-file-if-exists=.env scripts/warm-cache.mjs",
    "rush": "node scripts/rush.mjs"
  },
  "dependencies": {
    "@flagsmith/nodejs": "^9.5.0",
    "express": "^5.3.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "framer-motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
